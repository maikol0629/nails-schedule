generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Core multi-tenant user model ---

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  supabaseAuthId String         @unique
  role           UserRole       @default(STYLIST)
  status         AccountStatus  @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  stylistProfile     StylistProfile?
  verificationTokens VerificationToken[]
}

// --- Domain models scoped por supabaseUserId (tenant) ---

model Service {
  id              String   @id @default(cuid())
  supabaseUserId  String
  name            String
  description     String?  @db.Text
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  category        ServiceCategory
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments    Appointment[]
  portfolioImages PortfolioImage[]

  @@index([supabaseUserId])
  @@index([category])
  @@index([active])
}

model Client {
  id             String   @id @default(cuid())
  supabaseUserId String
  name           String
  phone          String
  email          String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments Appointment[]

  @@index([supabaseUserId])
  @@index([name])
  @@index([phone])
}

model Appointment {
  id             String            @id @default(cuid())
  supabaseUserId String
  clientId       String
  serviceId      String
  date           DateTime          @db.Date
  time           String
  duration       Int
  status         AppointmentStatus @default(PENDING)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([supabaseUserId])
  @@index([clientId])
  @@index([serviceId])
  @@index([date, time])
  @@index([status])
}

model PortfolioImage {
  id             String   @id @default(cuid())
  supabaseUserId String
  serviceId      String?
  imageUrl       String
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([supabaseUserId])
  @@index([serviceId])
}

// --- Multi-tenant stylist/business profile ---

model StylistProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  businessName      String
  ownerName         String
  category          BusinessCategory
  slug              String           @unique

  name              String
  bio               String?          @db.Text
  phone             String?
  whatsapp          String?
  email             String?
  emailVerified     Boolean          @default(false)
  whatsappVerified  Boolean          @default(false)
  emailVerifiedAt   DateTime?
  whatsappVerifiedAt DateTime?
  approvedBy        String?
  approvedAt        DateTime?

  primaryColor      String           @default("#EC4899")
  logoUrl           String?
  coverImageUrl     String?
  instagram         String?
  address           String?
  city              String?
  country           String           @default("Colombia")
  photoUrl          String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessHours {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique
  monday         Boolean  @default(true)
  tuesday        Boolean  @default(true)
  wednesday      Boolean  @default(true)
  thursday       Boolean  @default(true)
  friday         Boolean  @default(true)
  saturday       Boolean  @default(false)
  sunday         Boolean  @default(false)
  startTime      String   @default("09:00")
  endTime        String   @default("18:00")
  slotDuration   Int      @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BlockedDay {
  id             String   @id @default(cuid())
  supabaseUserId String
  date           DateTime @db.Date
  reason         String?
  createdAt      DateTime @default(now())

  @@unique([supabaseUserId, date])
  @@index([supabaseUserId])
  @@index([date])
}

// --- Verification & audit ---

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  token     String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
}

// --- Enums ---

enum ServiceCategory {
  CUT
  COLOR
  STYLE
  TREATMENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum UserRole {
  SUPER_ADMIN
  STYLIST
}

enum BusinessCategory {
  BARBERSHOP
  HAIR_SALON
  NAIL_SPA
}

enum AccountStatus {
  PENDING_VERIFICATION
  EMAIL_VERIFIED
  WHATSAPP_VERIFIED
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  WHATSAPP_VERIFICATION
  PASSWORD_RESET
}